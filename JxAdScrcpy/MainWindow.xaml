<Window x:Class="JxAdScrcpy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JxAdScrcpy"
        xmlns:viewmodels="clr-namespace:JxAdScrcpy.ViewModels"
        mc:Ignorable="d"
        Title="极限投屏控制" Height="700" Width="1000">
    
    <Window.DataContext>
        <viewmodels:MainViewModel/>
    </Window.DataContext>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部控制栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="{Binding IsConnected, Converter={StaticResource BoolToConnectTextConverter}}"
                    Command="{Binding ConnectCommand}"
                    Width="100" Height="30" Margin="0,0,10,0"/>
            <Button Content="刷新设备"
                    Command="{Binding RefreshDevicesCommand}"
                    Width="100" Height="30" Margin="0,0,10,0"/>
            <Button Content="截图所有设备"
                    Command="{Binding TakeAllScreenshotsCommand}"
                    Width="100" Height="30" Margin="0,0,10,0"
                    IsEnabled="{Binding IsConnected}"/>
            <TextBlock Text="{Binding Status}" 
                       VerticalAlignment="Center" 
                       Margin="20,0,0,0"/>
        </StackPanel>

        <!-- 主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            
            <!-- 设备列表 -->
            <ListView Grid.Column="0" 
                      ItemsSource="{Binding Devices}" 
                      SelectedItem="{Binding SelectedDevice}"
                      BorderThickness="1" 
                      BorderBrush="#DDDDDD">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="序号" DisplayMemberBinding="{Binding No}" Width="60"/>
                        <GridViewColumn Header="设备ID" DisplayMemberBinding="{Binding DeviceId}" Width="150"/>
                        <GridViewColumn Header="设备名称" DisplayMemberBinding="{Binding Name}" Width="150"/>
                    </GridView>
                </ListView.View>
            </ListView>
            
            <!-- 分隔线 -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
            
            <!-- 设备控制面板 -->
            <TabControl Grid.Column="2" Margin="5,0,0,0">
                <!-- 基本控制 -->
                <TabItem Header="基本控制">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- 设备信息 -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="当前设备:" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectedDevice.Name, FallbackValue='未选择设备'}"/>
                            <TextBlock Text="{Binding SelectedDevice.DeviceId, FallbackValue=''}"/>
                        </StackPanel>
                        
                        <!-- 控制按钮 -->
                        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                            <Button Content="截图" 
                                    Command="{Binding TakeScreenshotCommand}" 
                                    Width="80" Height="30" Margin="0,0,10,10"
                                    IsEnabled="{Binding SelectedDevice, Converter={StaticResource ObjectToBoolConverter}}"/>
                            <Button Content="独立窗口" 
                                    Command="{Binding ShowSingleWindowCommand}" 
                                    Width="80" Height="30" Margin="0,0,10,10"
                                    IsEnabled="{Binding SelectedDevice, Converter={StaticResource ObjectToBoolConverter}}"/>
                        </WrapPanel>
                        
                        <!-- 屏幕控制 -->
                        <GroupBox Grid.Row="2" Header="屏幕控制">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Text="手势操作" Margin="0,0,0,10"/>
                                
                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- 上滑 -->
                                    <Button Grid.Row="0" Grid.Column="1" Content="上滑" 
                                            Command="{Binding SwipeUpCommand}" 
                                            Margin="5" Padding="10,5"
                                            IsEnabled="{Binding SelectedDevice, Converter={StaticResource ObjectToBoolConverter}}"/>
                                    
                                    <!-- 左滑 -->
                                    <Button Grid.Row="1" Grid.Column="0" Content="左滑" 
                                            Command="{Binding SwipeLeftCommand}" 
                                            Margin="5" Padding="10,5"
                                            IsEnabled="{Binding SelectedDevice, Converter={StaticResource ObjectToBoolConverter}}"/>
                                    
                                    <!-- 点击 -->
                                    <Button Grid.Row="1" Grid.Column="1" Content="点击" 
                                            Command="{Binding TapScreenCommand}" 
                                            Margin="5" Padding="10,5"
                                            IsEnabled="{Binding SelectedDevice, Converter={StaticResource ObjectToBoolConverter}}"/>
                                    
                                    <!-- 右滑 -->
                                    <Button Grid.Row="1" Grid.Column="2" Content="右滑" 
                                            Command="{Binding SwipeRightCommand}" 
                                            Margin="5" Padding="10,5"
                                            IsEnabled="{Binding SelectedDevice, Converter={StaticResource ObjectToBoolConverter}}"/>
                                    
                                    <!-- 下滑 -->
                                    <Button Grid.Row="2" Grid.Column="1" Content="下滑" 
                                            Command="{Binding SwipeDownCommand}" 
                                            Margin="5" Padding="10,5"
                                            IsEnabled="{Binding SelectedDevice, Converter={StaticResource ObjectToBoolConverter}}"/>
                                    
                                    <!-- 返回键 -->
                                    <Button Grid.Row="2" Grid.Column="0" Content="返回键" 
                                            Command="{Binding BackButtonCommand}" 
                                            Margin="5" Padding="10,5"
                                            IsEnabled="{Binding SelectedDevice, Converter={StaticResource ObjectToBoolConverter}}"/>
                                </Grid>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </TabItem>
                
                <!-- 剪贴板 -->
                <TabItem Header="剪贴板">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <Button Grid.Row="0" Content="获取剪贴板内容" 
                                Command="{Binding GetClipboardCommand}" 
                                HorizontalAlignment="Left" 
                                Width="120" Height="30" Margin="0,0,0,10"
                                IsEnabled="{Binding SelectedDevice, Converter={StaticResource ObjectToBoolConverter}}"/>
                        
                        <TextBox Grid.Row="1" 
                                 Text="{Binding ClipboardContent}" 
                                 IsReadOnly="True" 
                                 TextWrapping="Wrap" 
                                 VerticalScrollBarVisibility="Auto"/>
                        
                        <TextBlock Grid.Row="2" Text="发送到剪贴板:" Margin="0,10,0,5"/>
                        
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox Grid.Column="0" 
                                     Text="{Binding ClipboardText, UpdateSourceTrigger=PropertyChanged}" 
                                     Margin="0,0,10,0"/>
                            
                            <Button Grid.Column="1" Content="发送" 
                                    Command="{Binding WriteClipboardCommand}" 
                                    Width="80" Height="30"
                                    IsEnabled="{Binding SelectedDevice, Converter={StaticResource ObjectToBoolConverter}}"/>
                        </Grid>
                    </Grid>
                </TabItem>
                
                <!-- ADB命令 -->
                <TabItem Header="ADB命令">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox Grid.Column="0" 
                                     Text="{Binding AdbCommand, UpdateSourceTrigger=PropertyChanged}" 
                                     Margin="0,0,10,0"/>
                            
                            <Button Grid.Column="1" Content="执行" 
                                    Command="{Binding ExecuteAdbCommandCommand}" 
                                    Width="80" Height="30"
                                    IsEnabled="{Binding SelectedDevice, Converter={StaticResource ObjectToBoolConverter}}"/>
                        </Grid>
                        
                        <TextBox Grid.Row="1" 
                                 Text="{Binding AdbCommandResult}" 
                                 IsReadOnly="True" 
                                 TextWrapping="Wrap" 
                                 FontFamily="Consolas" 
                                 VerticalScrollBarVisibility="Auto"/>
                        
                        <TextBlock Grid.Row="2" Margin="0,10,0,0">
                            <Run Text="提示: 使用"/>
                            <Run Text="am start -a android.intent.action.VIEW -d URL" FontWeight="Bold"/>
                            <Run Text="可以打开网页"/>
                        </TextBlock>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- 底部状态栏 -->
        <StatusBar Grid.Row="2" Height="25">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>

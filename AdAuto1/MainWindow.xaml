<Window x:Class="AdAuto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:AdAuto"
        xmlns:viewmodels="clr-namespace:AdAuto.ViewModels" 
        xmlns:converters="clr-namespace:AdAuto.Converters"
        xmlns:common="clr-namespace:AdAuto.Common"
        xmlns:enums="clr-namespace:AdAuto.enums"
        mc:Ignorable="d"
        Title="抖音极速版广告自动刷" Height="750" Width="800">
    <Window.DataContext>
        <viewmodels:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <converters:Base64ToImageConverter x:Key="Base64ToImageConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:IntegerValueConverter x:Key="IntegerValueConverter"/>
        <converters:VisibilityValueConverter x:Key="VisibilityValueConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Vertical">

            <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="10,10,1,10">
                <TextBlock Text="平台：" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox Width="150" Margin="0,0,10,0" ItemsSource="{common:Enumeration {x:Type enums:PlatformType}}" DisplayMemberPath="Description" SelectedValuePath="Value" SelectedValue="{Binding SelectedPlatform}"/>
                <TextBlock Text="设备：" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox Width="300" Margin="0,0,10,0" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock >
                                <Run Text="{Binding Name}"/>
                                <Run Text="/"/>
                                <Run Text="{Binding Product}"/>
                                <Run Text="/"/>
                                <Run Text="{Binding  Serial}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="刷新设备" Width="80" Margin="0,0,10,0" Command="{Binding RefreshDevicesCommand}" IsEnabled="{Binding IsRefreshEnabled}"/>
                <Button Content="投屏" Width="80" Margin="0,0,10,0" Command="{Binding ScrcpyStartRunCommand}"/>
            </WrapPanel>
            <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="10,0,0,10">
                <CheckBox Content="显示任务数据" IsChecked="{Binding ShowTaskData}"  Margin="0,0,10,0" VerticalAlignment="Center"/>
                <Button Content="清空选中" Width="80" Margin="0,0,10,0" Command="{Binding ClearSelectedTaskDataTypeCommand}"/>
                <ComboBox 
                    Width="100"
                    SelectedValue="{Binding CurPage}" 
                    ItemsSource="{Binding Source={common:Enumeration {x:Type  enums:AppPageEnum}}}" 
                    DisplayMemberPath="Description" 
                    SelectedValuePath="Value" 
                    Margin="0,0,10,0"
                    >
                </ComboBox>

                <TextBlock Text="最后停留时间：" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding LastClickTime}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </WrapPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="10">
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="120"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <GroupBox Header="操作控制" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Button Content="开始" Height="30" Margin="0,0,0,5" Command="{Binding StartCommand}" IsEnabled="{Binding IsStartEnabled}"/>
                        <Button Content="停止" Height="30" Margin="0,0,0,5" Command="{Binding StopCommand}" IsEnabled="{Binding IsStopEnabled}"/>
                    </StackPanel>
                </GroupBox>
                <Grid Grid.Row="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ListBox Grid.Column="0"  Width="150" ItemsSource="{Binding TaskDataTypes}" SelectedItem="{Binding SelectedTaskDataType}" 
                                    Visibility="{Binding ShowTaskData, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Border Margin="10,0,0,0" Grid.Column="1" BorderThickness="1" BorderBrush="#FFABADB3">
                            <TextBox Text="{Binding TaskDataText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible"
                                Visibility="{Binding ShowTaskData, Converter={StaticResource BooleanToVisibilityConverter}}">
                            </TextBox>
                        </Border>
                    </Grid>
                    <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible"
                                BorderThickness="1" BorderBrush="#FFABADB3" Visibility="{Binding ShowTaskData, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="TextChanged">
                                <i:CallMethodAction MethodName="ScrollToEnd"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                </Grid>
            </Grid>
        </Grid>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>

<ui:FluentWindow  x:Class="TimerCheckApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:ui="http://schemas.yuandl.cn/xamltheme/2024/xaml"
        xmlns:local="clr-namespace:TimerCheckApp"
        xmlns:views="clr-namespace:TimerCheckApp.Views"
        d:Background="{ui:ThemeResource ApplicationFillBrush}"
        d:Foreground="{ui:ThemeResource ApplicationTextColorBrush}"
        Background="{ui:ThemeResource ApplicationFillBrush}"
        Foreground="{ui:ThemeResource ApplicationTextColorBrush}"    
        mc:Ignorable="d"  Icon="/app_icon.ico"
        Title="安卓自动刷视频辅助工具" Height="800" Width="1100"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowState ="Normal"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="安卓自动刷视频辅助工具" ShowHelp="False">
            <ui:TitleBar.Icon>
                <Image Source="pack://application:,,,/TimerCheckApp;component/app_icon.ico" Width="20" Height="20" Stretch="Uniform"/>
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-3,0,0">
                    <ui:Button Content="重启" Command="{Binding RestartBtnCommand}" Margin="10,0" Background="{x:Null}" BorderThickness="0" CornerRadius="0"/>
                    <ui:Button Margin="10,0"  Icon="{ui:SymbolIcon Color24}" Command="{Binding ColorPickerButtonCommand}" CommandParameter="color" Background="{x:Null}" BorderThickness="0"  CornerRadius="0"/>
                    <ui:Button
                        Command="{Binding ToggleThemeButtonCommand}"
                        CommandParameter="theme"
                        Margin="10,0"
                        Icon="{ui:SymbolIcon DarkTheme24}"
                        ToolTip="Toggle theme" 
                        Background="{x:Null}" BorderThickness="0"  CornerRadius="0"/>
                    <ui:Flyout Placement="Bottom" IsOpen="{Binding IsFlyoutOpen}" Closed="Flyout_Closed">
                        <StackPanel>
                            <ui:ColorPicker x:Name="ColorPickerBorder" Color="{Binding Path=SystemColor}"/>
                        </StackPanel>
                    </ui:Flyout>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>
        <Grid Grid.Row="1" Margin="10">
            <views:MainView/>
        </Grid>
    </Grid>
</ui:FluentWindow>

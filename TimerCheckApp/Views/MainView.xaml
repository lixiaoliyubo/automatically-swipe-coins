<UserControl x:Class="TimerCheckApp.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.yuandl.cn/xamltheme/2024/xaml"
             xmlns:local="clr-namespace:TimerCheckApp.Views"
             xmlns:vm="clr-namespace:TimerCheckApp.ViewModels"
             xmlns:ms="clr-namespace:TimerCheckApp.Models"
             xmlns:ext="clr-namespace:TimerCheckApp.Extensions"
             xmlns:enums="clr-namespace:TimerCheckApp.enums"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:conv="clr-namespace:TimerCheckApp.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid>
        <TabControl x:Name="tabControl">
            <!-- ADB设备标签页 -->
            <TabItem Header="ADB设备">
                <Grid Background="{ui:ThemeResource ControlFillColorBrush}" Height="{Binding ActualHeight,ElementName=tabControl,Converter={StaticResource ValueToSizeConverter},ConverterParameter=-50}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="300"/>
                    </Grid.RowDefinitions>
                    
                    <!-- 工具栏 -->
                    <ToolBar Grid.Row="0" Background="{ui:ThemeResource ControlFillColorBrush}" BorderBrush="{ui:ThemeResource ControlBorderColorBrush}">
                        <ui:Button Content="刷新设备" Command="{Binding RefreshDevicesCommand}" Margin="5" Padding="5" Appearance="Success"/>
                        <ui:Button Content="清理所有" Command="{Binding CleanupAllCommand}" Margin="5" Padding="5" Appearance="Warning"/>
                        <ToggleButton Content="所有日志" IsChecked="{Binding ShowAllLogs}" Command="{Binding ViewAllLogsCommand}" Margin="5" Padding="5"  BorderBrush="{ui:ThemeResource ControlBorderColorBrush}"/>
                    </ToolBar>
                    
                    <!-- 设备列表 -->
                    <ui:DataGrid Grid.Row="1" 
                            MinRowHeight="25" 
                            ColumnHeaderPadding="10,0" 
                            HeadersVisibility="All" 
                            GridLinesVisibility="All" 
                            CanUserAddRows="False" 
                            RowHeaderWidth="0"
                            ColumnHeaderHeight="30"
                            SelectionUnit="FullRow"
                            BorderThickness="1"  AlternationCount="2"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ItemsSource="{Binding Devices}" 
                            SelectedItem="{Binding SelectedDevice}" 
                            AutoGenerateColumns="False" 
                            IsReadOnly="False" 
                            SelectionMode="Single" 
                            Margin="5">
                        <ui:DataGrid.Columns>
                            <ui:DataGridTextColumn Header="设备ID" Binding="{Binding Id}" Width="120"/>
                            <ui:DataGridTextColumn Header="设备名称" Binding="{Binding Name}" Width="150"/>
                            <ui:DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/>
                            <!--<ui:DataGridTextColumn Header="当前应用" Binding="{Binding CurrentApp}" Width="150"/>-->
                            <ui:DataGridComboBoxColumn Header="当前平台" SelectedValueBinding="{Binding CurPlatform}"  SelectedValuePath="Value" DisplayMemberPath="Description" ItemsSource="{ext:Enumeration {x:Type enums:PlatformType}}"  Width="100"/>
                            <ui:DataGridComboBoxColumn Header="当前页面" SelectedValueBinding="{Binding CurPage}" SelectedValuePath="Value" DisplayMemberPath="Description" ItemsSource="{ext:Enumeration {x:Type enums:AppPageEnum}}" Width="100"/>
                            <ui:DataGridTextColumn Header="最后检查时间" Binding="{Binding LastCheckTime, StringFormat='{}{0:HH:mm:ss}'}" Width="120"/>
                            <ui:DataGridTemplateColumn Header="操作" Width="*">
                                <ui:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button Content="启动" Margin="2" Padding="5,2" Appearance="Primary"
                                                    Command="{Binding DataContext.StartDeviceCheckCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                            <ui:Button Content="停止" Margin="2" Padding="5,2" Appearance="Error"
                                                    Command="{Binding DataContext.StopDeviceCheckCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <ui:Button Content="清理应用" Margin="2" Padding="5,2" Appearance="Error"
                                                    Command="{Binding DataContext.CleanDeviceAppsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <ui:Button Content="查看日志" Margin="2" Padding="5,2" Appearance="Warning"
                                                    Command="{Binding DataContext.ViewDeviceLogsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ui:DataGridTemplateColumn.CellTemplate>
                            </ui:DataGridTemplateColumn>
                        </ui:DataGrid.Columns>
                    </ui:DataGrid>
                    
                    <!-- 设备详情 -->
                    <Expander Grid.Row="2" Header="设备详情" IsExpanded="True" Margin="5">
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ui:TextBlock Grid.Row="0" Grid.Column="0" Text="当前应用:" FontWeight="Bold" Margin="0,0,5,0"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">

                                <ui:TextBlock Text="{Binding SelectedDevice.CurrentApp}" TextWrapping="Wrap" Margin="0,0,5,0"/>
                                <ui:TextBlock Text="{Binding SelectedDevice.CurPlatform}" TextWrapping="Wrap" Margin="0,0,5,0"/>
                                <ui:TextBlock Text="{Binding SelectedDevice.CurPage}" TextWrapping="Wrap" Margin="0,0,5,0"/>
                                <ui:TextBlock Text="{Binding SelectedDevice.Width}" TextWrapping="Wrap" Margin="0,0,5,0"/>
                                <ui:TextBlock Text="{Binding SelectedDevice.Height}" TextWrapping="Wrap" Margin="0,0,5,0"/>
                            </StackPanel>

                            <ui:TextBlock Grid.Row="1" Grid.Column="0" Text="OCR识别结果:" FontWeight="Bold" Margin="0,5,5,0"/>
                            <ui:TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDevice.LastOcrResult}" TextWrapping="Wrap" Margin="0,5,0,0" Height="50"/>
                        </Grid>
                    </Expander>
                    
                    <!-- 日志列表 -->
                    <GroupBox Grid.Row="3" Header="日志" Margin="5">
                        <Grid>
                            <TextBox x:Name="LogsTextBox"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     ScrollViewer.VerticalScrollBarVisibility="Visible">
                                <b:Interaction.Behaviors>
                                    <ext:TextBoxScrollBehavior ScrollCommand="{Binding ScrollToEndCommand}"/>
                                </b:Interaction.Behaviors>
                            </TextBox>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
            
            <!-- WebSocket标签页 -->
            <TabItem Header="WebSocket">
                <Grid Background="{ui:ThemeResource ControlFillColorBrush}" Height="{Binding ActualHeight,ElementName=tabControl,Converter={StaticResource ValueToSizeConverter},ConverterParameter=-50}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="200"/>
                    </Grid.RowDefinitions>
                    
                    <!-- WebSocket工具栏 -->
                    <ToolBar Grid.Row="0"  Background="{ui:ThemeResource ControlFillColorBrush}" BorderBrush="{ui:ThemeResource ControlBorderColorBrush}">
                        <ui:Button Content="连接" Command="{Binding ConnectWebSocketCommand}" Margin="5" Padding="5" Appearance="Primary"
                                Visibility="{Binding IsWebSocketConnected, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                        <ui:Button Content="断开" Command="{Binding DisconnectWebSocketCommand}" Margin="5" Padding="5" Appearance="Error"
                                Visibility="{Binding IsWebSocketConnected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <ui:Button Content="刷新设备" Command="{Binding GetWebSocketDevicesCommand}" Margin="5" Padding="5" Appearance="Warning"/>
                        <ui:TextBlock Text="连接状态:" VerticalAlignment="Center" Margin="5"/>
                        <ui:TextBlock Text="已连接" Foreground="Green" FontWeight="Bold" VerticalAlignment="Center" Margin="5"
                                   Visibility="{Binding IsWebSocketConnected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <ui:TextBlock Text="未连接" Foreground="Red" FontWeight="Bold" VerticalAlignment="Center" Margin="5"
                                   Visibility="{Binding IsWebSocketConnected, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                    </ToolBar>
                    
                    <!-- WebSocket设备列表和操作区域 -->
                    <Grid Grid.Row="1" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- 设备列表 -->
                        <GroupBox Grid.Column="0" Header="设备列表">
                            <ui:DataGrid 
                                MinRowHeight="25" 
                                ColumnHeaderPadding="10,0" 
                                HeadersVisibility="All" 
                                GridLinesVisibility="All" 
                                CanUserAddRows="False" 
                                RowHeaderWidth="0"
                                ColumnHeaderHeight="30"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                ItemsSource="{Binding WebSocketDevices}" SelectedItem="{Binding SelectedWebSocketDevice}" 
                                AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                                <ui:DataGrid.Columns>
                                    <ui:DataGridTextColumn Header="设备ID" Binding="{Binding Id}" Width="120"/>
                                    <ui:DataGridTextColumn Header="设备名称" Binding="{Binding Name}" Width="*"/>
                                </ui:DataGrid.Columns>
                            </ui:DataGrid>
                        </GroupBox>
                        
                        <!-- 操作区域 -->
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- 截图操作 -->
                                <GroupBox Header="截图操作" Margin="0,0,0,0">
                                    <StackPanel Margin="5">
                                        <DockPanel Margin="0,5">
                                            <ui:TextBlock Text="保存路径:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <ui:TextBox Text="{Binding ScreenshotSavePath}" Margin="0,0,5,0"/>
                                        </DockPanel>
                                        <ui:Button Content="截图" Command="{Binding TakeScreenshotCommand}" Margin="0,5" Padding="5"/>
                                    </StackPanel>
                                </GroupBox>
                                
                                <!-- 点击操作 -->
                                <GroupBox Header="点击操作" Margin="0,0,0,0">
                                    <StackPanel Margin="5">
                                        <ui:TextBlock Text="坐标格式: x,y (例如: 0.5,0.5)" Margin="0,5"/>
                                        <DockPanel Margin="0,5">
                                            <ui:TextBlock Text="坐标:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <ui:TextBox x:Name="CoordinatesTextBox" Margin="0,0,5,0"/>
                                        </DockPanel>
                                        <ui:Button Content="发送点击" Margin="0,5" Padding="5">
                                            <ui:Button.Command>
                                                <Binding Path="SendTapEventCommand"/>
                                            </ui:Button.Command>
                                            <ui:Button.CommandParameter>
                                                <Binding ElementName="CoordinatesTextBox" Path="Text"/>
                                            </ui:Button.CommandParameter>
                                        </ui:Button>
                                    </StackPanel>
                                </GroupBox>
                                
                                <!-- 指针事件操作 -->
                                <GroupBox Header="指针事件操作" Margin="0,0,0,0">
                                    <StackPanel Margin="5">
                                        <ui:TextBlock Text="参数格式: 事件类型,x,y[,endX,endY]" Margin="0,5"/>
                                        <ui:TextBlock Text="事件类型: 0=按下, 1=移动, 2=松开, 3=右键, 4=滚轮上, 5=滚轮下" Margin="0,5"/>
                                        <ui:TextBlock Text="滑动事件: 6=上滑, 7=下滑, 8=左滑, 9=右滑 (需要endX,endY)" Margin="0,5"/>
                                        <ui:TextBlock Text="示例: 0,0.5,0.5 或 6,0.5,0.5,0.5,0.8" Margin="0,5"/>
                                        <DockPanel Margin="0,5">
                                            <ui:TextBlock Text="参数:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <ui:TextBox x:Name="PointerEventParamsTextBox" Margin="0,0,5,0"/>
                                        </DockPanel>
                                        <ui:Button Content="发送指针事件" Margin="0,5" Padding="5">
                                            <ui:Button.Command>
                                                <Binding Path="SendPointerEventCommand"/>
                                            </ui:Button.Command>
                                            <ui:Button.CommandParameter>
                                                <Binding ElementName="PointerEventParamsTextBox" Path="Text"/>
                                            </ui:Button.CommandParameter>
                                        </ui:Button>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    
                    <!-- WebSocket日志 -->
                    <GroupBox Grid.Row="3" Header="日志" Margin="5">
                        <Grid>
                            <TextBox x:Name="WebSocketLogsTextBox"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas">
                                <b:Interaction.Behaviors>
                                    <ext:TextBoxScrollBehavior ScrollCommand="{Binding ScrollToEndCommand}"/>
                                </b:Interaction.Behaviors>
                            </TextBox>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
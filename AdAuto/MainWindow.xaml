<Window x:Class="AdAuto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:AdAuto"
        xmlns:viewmodels="clr-namespace:AdAuto.ViewModels" 
        xmlns:converters="clr-namespace:AdAuto.Converters"
        xmlns:common="clr-namespace:AdAuto.Extensions.Common;assembly=AdAuto.Extensions"
        xmlns:enums="clr-namespace:AdAuto.Extensions.enums;assembly=AdAuto.Extensions" 
        xmlns:ui="http://schemas.yuandl.cn/xamltheme/2024/xaml"
        mc:Ignorable="d"
        Title="抖音极速版广告自动刷" Height="800" Width="850">
    <Window.DataContext>
        <viewmodels:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <converters:Base64ToImageConverter x:Key="Base64ToImageConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:IntegerValueConverter x:Key="IntegerValueConverter"/>
        <converters:VisibilityValueConverter x:Key="VisibilityValueConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Vertical">

            <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="10,10,1,10">
                <TextBlock Text="平台：" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox MinWidth="150" Margin="0,0,10,0" ItemsSource="{common:Enumeration {x:Type enums:PlatformType}}" DisplayMemberPath="Description" SelectedValuePath="Value" SelectedValue="{Binding SelectedPlatform}"/>
                <TextBlock Text="设备：" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox MinWidth="150" Margin="0,0,10,0" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ui:Button Content="刷新设备" Margin="0,0,10,0" Command="{Binding RefreshDevicesCommand}" Appearance="Warning"/>
                <ui:Button Command="{Binding StartAdnStopCommand}" Margin="0,0,10,0">
                    <ui:Button.Style>
                        <Style BasedOn="{StaticResource DefaultUiButtonStyle}" TargetType="{x:Type ui:Button}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                    <Setter Property="Content" Value="开始" />
                                    <Setter Property="Appearance" Value="Primary" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Content" Value="停止" />
                                    <Setter Property="Appearance" Value="Error" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
                <ui:Button Content="投屏" Command="{Binding ScrcpyStartRunCommand}" Appearance="Success"/>
            </WrapPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="10,0,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="10,0,0,10">
                <CheckBox Content="显示任务数据" IsChecked="{Binding ShowTaskData}"  Margin="0,0,10,0" VerticalAlignment="Center"/>
                <ui:Button Content="清空选中" Width="100" Margin="0,0,10,0" Command="{Binding ClearSelectedTaskDataTypeCommand}"/>
                <CheckBox Content="实时捕获屏幕" IsChecked="{Binding IsCaptureScreenEnabled}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="关闭此选项可大幅降低CPU占用"/>
                <TextBlock Text="当前页面：" VerticalAlignment="Center"  Margin="0,0,10,0"/>
                <TextBlock Text="{Binding CurPage}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="最后停留时间：" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding LastClickTime}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </WrapPanel>
            <Grid Grid.Row="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0"  Width="150" ItemsSource="{Binding TaskDataTypes}" SelectedItem="{Binding SelectedTaskDataType}" 
                        Visibility="{Binding ShowTaskData, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Border Margin="10,0,0,0" Grid.Column="1" BorderThickness="1" BorderBrush="#ededed">
                        <TextBox Text="{Binding TaskDataText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible"
                    Visibility="{Binding ShowTaskData, Converter={StaticResource BooleanToVisibilityConverter}}">
                        </TextBox>
                    </Border>
                </Grid>
                <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible"
                    BorderThickness="1" BorderBrush="#ededed" Visibility="{Binding ShowTaskData, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="TextChanged">
                            <i:CallMethodAction MethodName="ScrollToEnd"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
            </Grid>
        </Grid>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
